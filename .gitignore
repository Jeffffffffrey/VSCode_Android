/app/src/main/assets/runtime/*
!/app/src/main/assets/runtime/PLACEHOLDER.txt

# ---- 内嵌 ELF（由 scripts/prepare-jnilibs.ps1 提取）----
/app/src/main/jniLibs/arm64-v8a/*.so

